#!/usr/bin/env python3
"""Markdown tables from tools/bench/engine-report results: engine-report-summary pass1 pass2"""
import json, os, sys

S = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))) + "/.build/engine-report/"
passes = sys.argv[1:]
data = {}  # (engine, test) -> [result per pass]
for name in passes:
    for line in open(S + f"report-{name}.jsonl"):
        entry = json.loads(line)
        if "test" not in entry or entry["test"].startswith("warm"): continue
        data.setdefault((entry["engine"], entry["test"]), {})[name] = entry.get("result") or entry.get("results")

engines = ["splish", "splash", "splosh"]
singles = ["single 10K", "single 50K", "single 150K", "single 200K"]

def mean(values):
    values = [v for v in values if v is not None]
    return sum(values) / len(values) if values else None

def fmt(value, digits=0):
    return "–" if value is None else f"{value:.{digits}f}"

print("### One prompt at a time\n")
print("Prefill is prompt tokens over time to the first token; decode is the 799 tokens after the first over the time they took. "
      f"Each cell: mean of the passes ({', '.join(passes)}), with each pass in brackets.\n")
print("| Prompt (tokens) | Engine | Time to first token, s | Prefill tok/s | Decode tok/s |")
print("|---|---|---|---|---|")
for test in singles:
    for engine in engines:
        runs = data.get((engine, test), {})
        ok = {p: r for p, r in runs.items() if isinstance(r, dict)}
        if not ok:
            print(f"| {test} | {engine} | {'; '.join(str(r)[:80] for r in runs.values()) or 'not run'} | | |"); continue
        tokens = mean([r["prompt"] for r in ok.values()])
        ttft = [r["ttft"] for r in ok.values()]
        prefill = [r["prompt"] / r["ttft"] for r in ok.values()]
        decode = [(r["completion"] - 1) / r["decode"] for r in ok.values()]
        each = lambda xs, d: " (" + " / ".join(fmt(x, d) for x in xs) + ")" if len(xs) > 1 else ""
        print(f"| {test[7:]} ({tokens:,.0f}) | {engine} | {fmt(mean(ttft), 1)}{each(ttft, 1)} | **{fmt(mean(prefill))}**{each(prefill, 0)} | **{fmt(mean(decode), 1)}**{each(decode, 1)} |")

print("\n### Four 20K prompts sent at once\n")
print("All four requests start together. Last first token: when the last prompt finished evaluating. "
      "Done: when the last reply finished. Combined: all prompt and generated tokens over that time.\n")
print("| Engine | Pass | First tokens at, s | Last first token, s | All done, s | Generated tok/s, all four together | Combined tok/s |")
print("|---|---|---|---|---|---|---|")
for engine in engines:
    for name, results in sorted(data.get((engine, "4 x 20K"), {}).items()):
        good = [r for r in results if isinstance(r, dict)]
        if len(good) < len(results):
            print(f"| {engine} | {name} | errors: {[r for r in results if not isinstance(r, dict)]} | | | | |"); continue
        firsts = sorted(r["ttft"] for r in good)
        done = max(r["ttft"] + r["decode"] for r in good)
        generated = sum(r["completion"] for r in good)
        prompt = sum(r["prompt"] for r in good)
        decode_window = done - min(firsts)
        print(f"| {engine} | {name} | {', '.join(f'{x:.0f}' for x in firsts)} | {firsts[-1]:.0f} | {done:.0f} | "
              f"{generated / decode_window:.1f} | {(prompt + generated) / done:.0f} |")
