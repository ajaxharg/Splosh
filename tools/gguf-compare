#!/usr/bin/env python3
"""Compare this engine with llama.cpp on one GGUF file: the same prompt, greedy, the same count
of tokens, both continuations and where they first differ.

THIS SCRIPT HAS NOT BEEN RUN. It was written while a live server held the GPU's memory, and
each of its two steps loads the whole model, so nothing below has been tried against a model:
not the flags given to llama.cpp (they were read from `llama-completion --help`, build 10470),
not what either program prints around its continuation. Read its first run with that in mind.

  1. `splosh generate --weights <artifact> --prompt <text> --max-tokens <n> --ids`: this
     engine on the artifact converted from the GGUF file (`splosh convert`). It is greedy and
     takes the prompt as text to complete, with no chat template. Its continuation is its
     standard output, less the newline it ends with; the token ids are in its standard error.
  2. `llama-completion -m <gguf> -p <text> -n <n> --temp 0 --top-k 1 -no-cnv ...`: llama.cpp
     on the file itself, the prompt taken as it is (no conversation, no escape processing) and
     not echoed. Special tokens are printed, as this engine prints them.

The two run one after the other, never together, and neither is started while a `splosh serve`
process is running: two loaded models do not fit in memory.

What the prompt's length exercises: the prefill runs in steps of up to --rows rows (64 unless
given), and the engine picks a GGUF kernel by a step's rows: up to 16 the split-K tile of 16,
17 to 32 the tile of 32, more the wide kernel. The default prompt is longer than 32 tokens, so
with no --rows the prefill is wide; `--rows 16` and `--rows 32` put the same prompt through the
other two. Decoding is one row a step whatever the prompt. (`splosh generate` also warms up
with a step of --rows rows and one of one row before the prompt, whose output nothing checks.)

Reading the result: two correct implementations agree on a greedy continuation until two
logits are near enough for their rounding to order them differently, which can take hundreds of
tokens or a few dozen. A difference in the first few tokens, or text that is not language, is a
fault. If only the first token differs, compare the prompt's token ids: `splosh generate --ids`
prints its own, `--verbose-prompt` puts llama.cpp's in its log (a BOS token one adds and the
other does not would show there). Both logs are kept in the directory named at the end.

usage: tools/gguf-compare <model.gguf> <artifact.splw> [options] [-- extra llama-completion arguments]

  --prompt <text>      the text to complete (default: a fixed paragraph of more than 32 tokens)
  --tokens <n>         tokens to generate, both sides (default 48)
  --rows <n>           rows of the prefill step, as SPLOSH_ROWS (default: the engine's 64)
  --context <n>        llama.cpp's context size (default 4096; the model's own is far larger)
  --tokenizer <dir>    default inputs/tokenizer
  --splosh <path>      default $SPLOSH_BIN, else .build/release/splosh; it must be a build of
                       an engine that dispatches the GGUF kernels
  --llama <path>       default /opt/homebrew/bin/llama-completion

exit status: 0 the continuations agree, 1 they differ, 2 nothing was compared.
"""
import argparse, os, re, subprocess, sys, tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PROMPT = ("The quick brown fox jumps over the lazy dog. A list of the months of the year, in order, "
          "each followed by its number of days in a common year: January has 31 days, February has 28 days, "
          "March has 31 days, April has 30 days, May has")
# What may follow the last agreed character without being a difference: white space, and the
# end-of-text marks llama.cpp prints when the model stops (this engine prints nothing for them).
TRAILER = re.compile(r"(\s|<\|im_end\|>|<\|endoftext\|>|\[end of text\])*")


def serving():
    """The `splosh serve` processes running now, as (pid, command)."""
    listing = subprocess.run(["ps", "-axo", "pid=,command="], capture_output=True, text=True, check=True).stdout
    found = []
    for line in listing.splitlines():
        pid, _, command = line.strip().partition(" ")
        if re.search(r"(^|[/\s])splosh\s+serve(\s|$)", command):
            found.append((pid, command.strip()))
    return found


def refuse_if_serving(before):
    running = serving()
    if running:
        print(f"gguf-compare: `splosh serve` is running; not loading a second model {before}:", file=sys.stderr)
        for pid, command in running:
            print(f"  {pid}  {command}", file=sys.stderr)
        sys.exit(2)


def run(name, command, log, **options):
    """Run one of the two programs to its end; its standard output, decoded. Standard error goes to `log`."""
    print(f"gguf-compare: {name}: {' '.join(command[:2])} ...", file=sys.stderr, flush=True)
    with open(log, "wb") as errors:
        done = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=errors, **options)
    if done.returncode != 0:
        print(f"gguf-compare: {name} exited {done.returncode}; the end of {log}:", file=sys.stderr)
        with open(log, "rb") as errors:
            sys.stderr.write(errors.read().decode("utf-8", "replace")[-2000:])
        sys.exit(2)
    return done.stdout.decode("utf-8", "replace")


def ids(log, label):
    """The token ids `splosh generate --ids` wrote to its standard error under `label`."""
    with open(log, "rb") as errors:
        match = re.search(rf"^{label}: \[(.*)\]$", errors.read().decode("utf-8", "replace"), re.MULTILINE)
    return [int(item) for item in match.group(1).split(",") if item.strip()] if match else None


def main():
    arguments, extra = sys.argv[1:], []
    if "--" in arguments:
        cut = arguments.index("--")
        arguments, extra = arguments[:cut], arguments[cut + 1:]
    parser = argparse.ArgumentParser(prog="gguf-compare", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("gguf")
    parser.add_argument("artifact")
    parser.add_argument("--prompt", default=PROMPT)
    parser.add_argument("--tokens", type=int, default=48)
    parser.add_argument("--rows", type=int)
    parser.add_argument("--context", type=int, default=4096)
    parser.add_argument("--tokenizer", default=os.path.join(ROOT, "inputs/tokenizer"))
    parser.add_argument("--splosh", default=os.environ.get("SPLOSH_BIN", os.path.join(ROOT, ".build/release/splosh")))
    parser.add_argument("--llama", default="/opt/homebrew/bin/llama-completion")
    args = parser.parse_args(arguments)

    for path, what in [(args.gguf, "GGUF file"), (args.artifact, "artifact"), (args.splosh, "splosh binary"), (args.llama, "llama.cpp binary")]:
        if not os.path.isfile(path):
            print(f"gguf-compare: no {what} at {path}", file=sys.stderr)
            return 2
    if args.tokens < 1:
        print("gguf-compare: --tokens must be at least 1", file=sys.stderr)
        return 2
    logs = tempfile.mkdtemp(prefix="gguf-compare-")
    splosh_log, llama_log = os.path.join(logs, "splosh.log"), os.path.join(logs, "llama.log")

    refuse_if_serving("for this engine")
    environment = dict(os.environ)
    if args.rows:
        environment["SPLOSH_ROWS"] = str(args.rows)
    ours = run("this engine", [args.splosh, "generate", "--prompt", args.prompt, "--weights", os.path.abspath(args.artifact),
                               "--tokenizer", os.path.abspath(args.tokenizer), "--max-tokens", str(args.tokens), "--ids"],
               splosh_log, cwd=ROOT, env=environment)
    # `generate` ends its output with one newline of its own.
    if ours.endswith("\n"):
        ours = ours[:-1]
    prompt_ids, generated_ids = ids(splosh_log, "prompt ids"), ids(splosh_log, "generated ids")

    # The first process has exited and its mapping with it; a server may have started meanwhile.
    refuse_if_serving("for llama.cpp")
    theirs = run("llama.cpp", [args.llama, "-m", os.path.abspath(args.gguf), "-p", args.prompt, "-n", str(args.tokens),
                               "--temp", "0", "--top-k", "1", "--seed", "0", "-c", str(args.context),
                               "-no-cnv", "--no-display-prompt", "--no-escape", "--special", "--simple-io", "--verbose-prompt"] + extra,
                 llama_log)

    print(f"prompt ({len(prompt_ids) if prompt_ids is not None else '?'} tokens by this engine's tokenizer):")
    print(args.prompt)
    print(f"\n--- this engine ({len(generated_ids) if generated_ids is not None else '?'} tokens) ---")
    print(ours)
    print("\n--- llama.cpp ---")
    print(theirs)

    common = 0
    while common < min(len(ours), len(theirs)) and ours[common] == theirs[common]:
        common += 1
    print("\n--- comparison ---")
    same = TRAILER.fullmatch(ours[common:]) is not None and TRAILER.fullmatch(theirs[common:]) is not None
    if same:
        print(f"the continuations agree: {common} characters, then only white space or an end-of-text mark")
    else:
        line = ours.count("\n", 0, common) + 1
        print(f"the continuations agree for {common} characters and first differ at character {common} (line {line}):")
        start = max(0, common - 60)
        print(f"  agreed before it: {ours[start:common]!r}")
        print(f"  this engine then: {ours[common:common + 60]!r}")
        print(f"  llama.cpp then:   {theirs[common:common + 60]!r}")
        if common >= min(len(ours), len(theirs)):
            print("  (one continuation is the start of the other: it stopped earlier, or printed less of its last token)")
    if generated_ids is not None:
        print(f"this engine's generated ids: {generated_ids}")
    print(f"logs: {splosh_log} (prompt and generated ids, timings), {llama_log} (llama.cpp's prompt tokens and load)")
    return 0 if same else 1


if __name__ == "__main__":
    sys.exit(main())
